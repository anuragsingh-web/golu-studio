# Copy to .env and fill in. The .env file is never committed or logged.
# Default provider: cursor-agent = your Cursor subscription via the Cursor CLI (no key needed).
# AI_PROVIDER=cursor-agent     # or: claude-code | anthropic | gemini
# CURSOR_CLI_PATH=             # only if cursor-agent isn't in ~/.local/bin or on PATH
# CURSOR_AGENT_TEXT_MODEL=     # default: newest Claude Sonnet from `cursor-agent --list-models`
# CURSOR_AGENT_CODE_MODEL=     # default: newest Claude Opus (fallback: auto)
# CURSOR_AGENT_CONCURRENCY=2
# CURSOR_AGENT_TIMEOUT_MIN=25   # 10 was too short for H5; avoid *-high / thinking models
# CURSOR_API_KEY=               # required when hosting (Cursor Dashboard → API Keys: https://cursor.com/dashboard/api)

# Claude Code (Claude Pro/Max subscription)
# CLAUDE_CLI_PATH=             # only if `claude` isn't on PATH
# CLAUDE_CODE_TEXT_MODEL=sonnet
# CLAUDE_CODE_CODE_MODEL=opus
# CLAUDE_CODE_CONCURRENCY=2
# CLAUDE_CODE_TIMEOUT_MIN=10

# Optional: Anthropic API key (set AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# Optional: Google Gemini instead (set AI_PROVIDER=gemini)
# GEMINI_API_KEY=

# Optional model overrides (default: newest available, picked from the provider's models list)
# ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5
# ANTHROPIC_CODE_MODEL=claude-opus-4-1
# GEMINI_TEXT_MODEL=gemini-2.5-pro

# Optional
# PORT=5173
# HOST=127.0.0.1         # use 0.0.0.0 to share on your network / when hosting
# MOCK=1                 # offline demo mode
# CHROME_PATH=           # path to Chrome/Edge/Chromium if not auto-detected (needed for GIFs + H5 validation)
# NO_OPEN=1              # don't auto-open the browser on start
# APP_PASSWORD=          # optional HTTP basic auth (username defaults to golu). Off when unset. Recommended when public.
# APP_USER=golu

# Auto-sync Pintu ratings from the shared Google Sheet (Anyone with the link → Viewer).
# Defaults are already set in code; uncomment only to override or to turn sync off.
# RATINGS_SHEET_URL=https://docs.google.com/spreadsheets/d/1jToJ8Jt5pfbEwCM_rJBu2e60o6HUOdyEiTweK1T9sAY/export?format=csv&gid=120944992
# RATINGS_SHEET_META_URL=https://docs.google.com/spreadsheets/d/1jToJ8Jt5pfbEwCM_rJBu2e60o6HUOdyEiTweK1T9sAY/export?format=csv&gid=1093157980
# RATINGS_SYNC_INTERVAL_MS=1800000
# RATINGS_SHEET_URL=off

# Nightly autopilot (`npm run autopilot`). Actions sets these; locally MOCK=1 needs no key.
# AUTOPILOT_COUNT=20
# AUTOPILOT_THRESHOLD=7
# AUTOPILOT_PARALLEL=2
# AUTOPILOT_GAME_TIMEOUT_MIN=30
# H5_FIX_ROUNDS=1          # Create H5 fix attempts. Unset locally (3). The night job uses 1.

# Rate My Game
# RATE_MAX_MB=2048          # per-file upload limit
# RATE_TIMEOUT_MIN=12        # AI judging timeout
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg   # only if ffmpeg isn't on PATH (brew install ffmpeg)
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
